{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "ignoreDeprecations": "6.0",
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
