COOKIE_NAME="aff_token"
LOCKOUT_THRESHOLD="5"
LOCKOUT_DURATION_MS="60000"
BCRYPT_ROUNDS="12"
ADMIN_UNDO_WINDOW_MS="600000"
ADMIN_SWEEP_INTERVAL_MS="60000"
